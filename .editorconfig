# editorconfig.org — basic whitespace rules for every editor
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs,cjs,ts,mts,tsx,jsx}]
max_line_length = 90

[*.md]
trim_trailing_whitespace = false
max_line_length = off
