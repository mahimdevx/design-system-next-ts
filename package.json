{
  "name": "design-system-next-ts",
  "version": "0.1.0",
  "private": true,
  "description": "A design system for React and Next.js: accessible components, design tokens and dark mode, built with Tailwind CSS v4 and Radix UI.",
  "keywords": [
    "design-system",
    "react",
    "nextjs",
    "tailwindcss",
    "radix-ui",
    "components",
    "typescript"
  ],
  "homepage": "https://github.com/mahimdevx/design-system-next-ts#readme",
  "bugs": {
    "url": "https://github.com/mahimdevx/design-system-next-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahimdevx/design-system-next-ts.git"
  },
  "license": "MIT",
  "author": "Mahim Farhad",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  }
}
