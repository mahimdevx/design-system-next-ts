{
  "name": "design-system-next-ts",
  "version": "0.1.0",
  "private": true,
  "description": "A design system for React and Next.js: accessible components, design tokens and dark mode, built with Tailwind CSS v4 and Radix UI.",
  "keywords": [
    "design-system",
    "react",
    "nextjs",
    "tailwindcss",
    "radix-ui",
    "components",
    "typescript"
  ],
  "homepage": "https://github.com/mahimdevx/design-system-next-ts#readme",
  "bugs": {
    "url": "https://github.com/mahimdevx/design-system-next-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahimdevx/design-system-next-ts.git"
  },
  "license": "MIT",
  "author": "Mahim Farhad",
  "scripts": {
    "dev": "concurrently --names next,types --prefix-colors blue,magenta --kill-others --passthrough-arguments \"next dev {@}\" \"pnpm run dev:types\" --",
    "dev:types": "next typegen && tsc --noEmit --watch --preserveWatchOutput",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.7",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.15"
  }
}
